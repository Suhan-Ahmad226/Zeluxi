// Prisma Schema for Zelux — Production Single-Store E-Commerce Platform
// Database: PostgreSQL with Prisma ORM

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CourierProvider {
  PATHAO
  STEADFAST
  IN_HOUSE
}

enum InventoryActionType {
  RESTOCK
  RESERVE
  RELEASE
  FULFILL
  ADJUSTMENT
  RETURN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?
  fullName      String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  questions     Question[]
  wishlist      WishlistItem[]
  cartItems     CartItem[]
  auditLogs     AuditLog[]
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String
  division       String
  district       String
  thanaCity      String
  addressDetails String
  postalCode     String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  nameBn      String?
  slug        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id               String           @id @default(uuid())
  name             String
  nameBn           String?
  slug             String           @unique
  sku              String           @unique
  shortDescription String?
  description      String
  price            Int              // In BDT minor units or exact integer BDT
  compareAtPrice   Int?
  costPrice        Int?
  isPublished      Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  stock            Int              @default(0)
  lowStockAlert    Int              @default(3)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  questions        Question[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  inventoryLogs    InventoryLog[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
}

model ProductVariant {
  id        String      @id @default(uuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String      @unique
  name      String
  size      String?
  color     String?
  price     Int
  stock     Int         @default(0)

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id             String          @id @default(uuid())
  orderNumber    String          @unique // e.g. LFM-2601
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  addressId      String?
  address        Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  
  // Snapshots of guest customer info
  customerName   String
  customerPhone  String
  customerEmail  String
  shippingAddress String
  division       String
  notes          String?

  // Financials (BDT integers)
  subtotal       Int
  shippingFee    Int
  discount       Int             @default(0)
  grandTotal     Int

  status         OrderStatus     @default(PENDING)
  paymentMethod  PaymentMethod   @default(COD)
  paymentStatus  PaymentStatus   @default(PENDING)
  trxId          String?

  courier        CourierProvider @default(PATHAO)
  trackingCode   String?
  consignmentId  String?
  estimatedDelivery String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantLabel String?
  price       Int
  quantity    Int
  image       String?
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String
  actor     String      @default("SYSTEM")
  timestamp DateTime    @default(now())
}

model InventoryLog {
  id        String              @id @default(uuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      InventoryActionType
  quantity  Int
  note      String?
  actor     String              @default("SYSTEM")
  createdAt DateTime            @default(now())
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String    // PERCENTAGE or FIXED
  value       Int
  minSpend    Int       @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usageCount  Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName           String
  rating             Int      @default(5)
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Question {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String
  timestamp  DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id          String   @id @default(uuid())
  source      String   // PATHAO, STEADFAST, BKASH, SSLCOMMERZ
  eventType   String
  payload     String
  status      String   @default("RECEIVED")
  createdAt   DateTime @default(now())
}
