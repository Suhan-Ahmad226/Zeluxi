# Zeluxi (Next.js 16) environment template
# Copy this file to .env.local for local development.
# Put real values in .env.local / Vercel Environment Variables only. Never commit secrets.

# ---------------------------------------------------------------------------
# Public site URL
# Used for canonical metadata and server-side auth redirect fallbacks.
# Local: http://localhost:3000 | Production: your real HTTPS site origin
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase project (all values must belong to the SAME Supabase project)
# Browser auth reads only NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY from the compiled Next.js client bundle.
# Use the project's publishable/anon key here, NEVER a service-role/secret key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side API configuration. The API routes use these as fallbacks for URL
# and anon key, and require SUPABASE_SERVICE_ROLE_KEY for privileged operations.
# SUPABASE_ANON_KEY is the same public anon/publishable key, not a secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# COD shipping policy. Required by POST /api/orders.
# Amounts are in BDT. Fill these with the actual approved store policy.
# FREE_SHIPPING_THRESHOLD must be greater than 0.
# ---------------------------------------------------------------------------
SHIPPING_DHAKA_FEE=
SHIPPING_OUTSIDE_DHAKA_FEE=
FREE_SHIPPING_THRESHOLD=

# ---------------------------------------------------------------------------
# Cloudinary media storage (server-only credentials)
# Configure the same values in Vercel Project Settings > Environment Variables.
# API Secret must NEVER use a NEXT_PUBLIC_ prefix or be committed.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=lc8fsuka
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# GitHub Actions only: database migration workflow secret, if/when that
# workflow is enabled. Add SUPABASE_DB_URL in GitHub repository
# Settings > Secrets and variables > Actions. Do not put it in this file
# or Vercel. Never commit a database connection string.
# ---------------------------------------------------------------------------

# Notes:
# - Do not add VITE_* variables: this repository's browser app is Next.js.
# - Do not expose SUPABASE_SERVICE_ROLE_KEY with a NEXT_PUBLIC_ prefix.
# - New product, category, and storefront media uses Cloudinary. Existing Supabase
#   Storage URLs remain compatible during gradual replacement.
# - Pathao server-side routes are available on development after applying the
#   courier migration and setting server-side variables. Online payment gateways
#   remain disabled until a real server-side verifier is implemented.


# Pathao Courier Merchant API (server-only; never use NEXT_PUBLIC_ prefix)
# Keep sandbox as the default until production merchant approval and sandbox validation.
PATHAO_MODE=sandbox
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# Used per item only when the product has no positive weightKg metadata. Set a realistic BDT-store default.
PATHAO_DEFAULT_ITEM_WEIGHT_KG=0.5
# Random 32-byte key encoded as base64 or 64 hex chars; never reuse the API secret.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PATHAO_TOKEN_ENCRYPTION_KEY=
