# Zeluxi environment template
# Copy to .env.local for local development and fill only the values required by the feature.
# Never commit .env.local or real credentials.
#
# CURRENTLY USED BY THE FRONTEND / VITE CONFIG
# Public Supabase project URL and anon/publishable key. These are intentionally public;
# protect data with Supabase RLS and trusted server-side authorization.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local Vite dev-server switch. Set true only if you need to disable HMR/file watching.
DISABLE_HMR=false

# SERVER-ONLY / FUTURE INTEGRATION CONFIGURATION
# This repository currently ships as a Vite static frontend. The variables below are
# placeholders for server-side APIs/integrations and are NOT proof that those integrations
# are implemented or active. Do not put these secrets in VITE_* variables or browser code.
# Do not configure secret values in a static frontend deployment unless a trusted server
# function actually reads them. Never expose service-role, payment, courier, or bot secrets.

# Database (Prisma schema; requires a server runtime to be used for commerce operations)
DATABASE_URL=
DIRECT_URL=

# Supabase admin access (SERVER ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (API credentials are SERVER ONLY; cloud name is not secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider (SERVER ONLY)
GEMINI_API_KEY=

# Redis / cache (SERVER ONLY)
REDIS_URL=

# Payment gateways (SERVER ONLY; keep sandbox mode enabled until server verification is implemented)
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

BKASH_MERCHANT_APP_KEY=
BKASH_MERCHANT_PASSWORD=
BKASH_MERCHANT_SECRET_KEY=
BKASH_MERCHANT_SHORT_CODE=
BKASH_MERCHANT_USERNAME=

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

ROCKET_MERCHANT_BILLER_ID=
ROCKET_MERCHANT_PASSWORD=

# Courier integrations (SERVER ONLY; credentials do not enable live booking by themselves)
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_USERNAME=

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Monitoring / notifications (SERVER ONLY)
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
