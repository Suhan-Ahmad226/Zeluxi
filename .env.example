
# Next.js / Supabase public browser configuration. These values are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only aliases for API routes. Never prefix secret keys with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma schema; requires a server runtime to be used for commerce operations)
DATABASE_URL=
DIRECT_URL=

# Cloudinary (API credentials are SERVER ONLY; cloud name is not secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider (SERVER ONLY)
GEMINI_API_KEY=

# Social Media Studio (SERVER ONLY; never expose Meta tokens or secrets to the browser)
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_REDIRECT_URI=https://zeluxi.vercel.app/api/admin/social/oauth/callback
# Generate a unique 32-byte encryption key and store it as 64 hex characters.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Random secret used to authorize the internal scheduler HTTP endpoint.
CRON_SECRET=

# Redis / cache (SERVER ONLY)
REDIS_URL=

# Payment gateways (SERVER ONLY; keep sandbox mode enabled until server verification is implemented)
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

BKASH_MERCHANT_APP_KEY=
BKASH_MERCHANT_PASSWORD=
BKASH_MERCHANT_SECRET_KEY=
BKASH_MERCHANT_SHORT_CODE=
BKASH_MERCHANT_USERNAME=

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

ROCKET_MERCHANT_BILLER_ID=
ROCKET_MERCHANT_PASSWORD=

# Courier integrations (SERVER ONLY; credentials do not enable live booking by themselves)
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_USERNAME=

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Monitoring (SERVER ONLY)
SENTRY_DSN=
