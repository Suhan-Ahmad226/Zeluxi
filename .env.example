# Zeluxi (Next.js 16) environment template
# Copy this file to .env.local for local development.
# Put real values in .env.local / Vercel Environment Variables only. Never commit secrets.

# Runtime
# Next.js/Vercel also sets NODE_ENV automatically in deployed environments.
NODE_ENV=development

# Public site URL: canonical metadata and server-side auth redirect fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project: all values must belong to the SAME project.
# Browser-safe publishable/anon key only. NEVER put service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side API configuration. SUPABASE_URL and SUPABASE_ANON_KEY can fall back
# to the matching NEXT_PUBLIC values. Service role is required for privileged APIs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# COD shipping policy, BDT. Required by the order API; threshold must be positive.
SHIPPING_DHAKA_FEE=
SHIPPING_OUTSIDE_DHAKA_FEE=
FREE_SHIPPING_THRESHOLD=

# Cloudinary media storage, server-only credentials.
CLOUDINARY_CLOUD_NAME=lc8fsuka
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub Actions only: configure SUPABASE_DB_URL as a repository Actions secret.
# Do NOT put that database connection string here or in Vercel.

# Pathao Merchant API, server-only. Keep sandbox until merchant approval and testing.
# sandbox: https://courier-api-sandbox.pathao.com
# production: https://api-hermes.pathao.com
PATHAO_MODE=sandbox
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# Used per item only when the product has no positive weightKg metadata. Set a realistic BDT-store default.
PATHAO_DEFAULT_ITEM_WEIGHT_KG=0.5
# Random 32-byte key encoded as base64 or 64 hex chars; never reuse the API secret.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PATHAO_TOKEN_ENCRYPTION_KEY=

# Do not add VITE_* variables to this Next.js app.
# Do not expose service-role, Cloudinary API secret, or Pathao credentials via NEXT_PUBLIC_*.
# Online payments remain disabled until a real server-side verifier/webhook is implemented.
