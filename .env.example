# Public browser-safe Supabase configuration (these values are intentionally public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase credentials. Never use NEXT_PUBLIC_ for the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Optional media service credentials (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-calculated COD shipping configuration (all three are required to enable the order API)
SHIPPING_DHAKA_FEE=
SHIPPING_OUTSIDE_DHAKA_FEE=
FREE_SHIPPING_THRESHOLD=

# Payment gateways remain disabled until verified merchant credentials and webhook signatures are configured.
# SSL_COMMERZ_STORE_ID=
# SSL_COMMERZ_STORE_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=

# Courier APIs remain disabled until merchant credentials and sandbox/live account approval.
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=

# Optional monitoring
# SENTRY_DSN=
