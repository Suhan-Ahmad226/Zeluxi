# Zeluxi Next.js local configuration. Copy to .env.local; never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server configuration (same project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Required for COD checkout. Values are BDT and must match the store policy.
SHIPPING_DHAKA_FEE=
SHIPPING_OUTSIDE_DHAKA_FEE=
FREE_SHIPPING_THRESHOLD=

# GitHub Actions database migration secret only; configure in GitHub Settings > Secrets and variables > Actions.
# Do not put the real value here, in Vercel, or in committed files: SUPABASE_DB_URL

# Product photos use Supabase Storage bucket zelux-products; apply migrations first.
# Online payment gateways and courier booking/tracking are not yet end-to-end implemented.
