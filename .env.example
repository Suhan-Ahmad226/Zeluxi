# Zeluxi (Next.js 16) environment template
# Copy this file to .env.local for local development.
# Put real values in .env.local / Vercel Environment Variables only. Never commit secrets.

# ---------------------------------------------------------------------------
# Public site URL
# Used for canonical metadata and server-side auth redirect fallbacks.
# Local: http://localhost:3000 | Production: your real HTTPS site origin
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase project (all values must belong to the SAME Supabase project)
# Browser auth reads only NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY from the compiled Next.js client bundle.
# Use the project's publishable/anon key here, NEVER a service-role/secret key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side API configuration. The API routes use these as fallbacks for URL
# and anon key, and require SUPABASE_SERVICE_ROLE_KEY for privileged operations.
# SUPABASE_ANON_KEY is the same public anon/publishable key, not a secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# COD shipping policy. Required by POST /api/orders.
# Amounts are in BDT. Fill these with the actual approved store policy.
# FREE_SHIPPING_THRESHOLD must be greater than 0.
# ---------------------------------------------------------------------------
SHIPPING_DHAKA_FEE=
SHIPPING_OUTSIDE_DHAKA_FEE=
FREE_SHIPPING_THRESHOLD=

# ---------------------------------------------------------------------------
# GitHub Actions only: database migration workflow secret, if/when that
# workflow is enabled. Add SUPABASE_DB_URL in GitHub repository
# Settings > Secrets and variables > Actions. Do not put it in this file
# or Vercel. Never commit a database connection string.
# ---------------------------------------------------------------------------

# Notes:
# - Do not add VITE_* variables: this repository's browser app is Next.js.
# - Do not expose SUPABASE_SERVICE_ROLE_KEY with a NEXT_PUBLIC_ prefix.
# - Product images use the Supabase Storage bucket "zelux-products";
#   bucket/policies must be configured in Supabase.
# - Online payment gateways and courier booking/tracking are not yet
#   implemented end-to-end according to README.md.
